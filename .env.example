# Backend API Key (for frontend -> backend authentication)
# For development: use any string like 'dev-test-key-12345'
# For production: generate a strong random key using: openssl rand -hex 32
AIRRA_API_KEY=dev-test-key-12345

# Groq API Key
# Get your API key from: https://console.groq.com/keys
AIRRA_OPENAI_API_KEY=your_groq_api_key_here

# Telemetry source. Keep "demo" for the synthetic portfolio simulator.
# Set "kubernetes" only when running labs/kubernetes/README.md.
AIRRA_PROMETHEUS_METRIC_PROFILE=demo
AIRRA_KUBERNETES_NAMESPACE=airra-lab

# --- Integrated run: AIRRA monitors the AI Engineering Platform ---
# docs/superpowers/specs/2026-09-10-airra-ai-platform-integration-design.md
# Uncomment, then bring up both stacks joined to the `airra-mesh` network.
# AIRRA_PROMETHEUS_METRIC_PROFILE=kubernetes
# AIRRA_KUBERNETES_NAMESPACE=ai-platform
# AIRRA_MONITORED_SERVICES=["api","orchestrator","researcher","tool_runner","executor","verifier"]

# Shared secret Prometheus Alertmanager presents (Bearer token) when it calls
# POST /api/v1/webhooks/alertmanager -- the push-based detection path.
# Must match the literal value in monitoring/prometheus/alertmanager.yml
# (Alertmanager's config has no env-var interpolation, so that file hardcodes
# the same string; change both together). Default is fine for local/demo use.
# AIRRA_ALERTMANAGER_WEBHOOK_TOKEN=airra-alertmanager-webhook-dev-secret

# PostgreSQL password (CRIT-4)
# Development default is 'airra' (see docker-compose.yml fallback).
# For production: generate with: openssl rand -hex 16
POSTGRES_PASSWORD=airra

# Grafana admin password (HIGH-5)
# REQUIRED — no fallback. Generate with: openssl rand -hex 16
GRAFANA_PASSWORD=change_me_before_running
